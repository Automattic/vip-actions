{
  "name": "docs-doctor",
  "description": "GitHub Action to analyze documentation sites for inconsistencies and issues using AI.",
  "version": "0.0.1",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "format": "prettier '**/*.(js|json|jsx|md|ts|tsx|yml|yaml)' --write"
  },
  "type": "module",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@ai-sdk/openai": "^2.0.15",
    "@mendable/firecrawl-js": "^1.29.3",
    "ai": "^5.0.15",
    "turndown": "^7.2.1",
    "xml2js": "^0.6.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@automattic/eslint-plugin-wpvip": "0.13.1",
    "@github/local-action": "^5.1.0",
    "@types/node": "^24.1.0",
    "@types/turndown": "^5.0.5",
    "@types/xml2js": "^0.4.14",
    "@vercel/ncc": "^0.38.3",
    "prettier": "npm:wp-prettier@2.8.5",
    "typescript": "^5.8.3"
  }
}
